[Unit]
Description=Edgevest Trade Server (gunicorn)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/edgevest/backend
EnvironmentFile=/home/ubuntu/edgevest/.env.production
ExecStart=/home/ubuntu/edgevest/backend/edgevest-web
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
