[Unit]
Description=Edgevest Live Poller
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/edgevest/backend
EnvironmentFile=/home/ubuntu/edgevest/backend/.env.production
ExecStart=/home/ubuntu/edgevest/backend/edgevest-poller
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
